<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Sunucu verisinin Mac'e günlük kopyası (scripts/tools/server-backup.sh, ~/.local/bin/tr-energy-server-backup.sh olarak kopyalanır: launchd Masaüstü'ndeki betiği çalıştıramaz): her gün 13:00. Mac uykudaysa uyanınca çalışır;
  kapalıysa o gün atlanır, ertesi gün kaldığı yerden (rsync yalnız değişeni çeker). Kurulum: scripts/launchd/README.md.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tr-energy.server-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/test/.local/bin/tr-energy-server-backup.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>13</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/test/Library/Logs/tr-energy-server-backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/test/Library/Logs/tr-energy-server-backup.log</string>
</dict>
</plist>
