// Prisma Schema for TR-Energy Analyst
// Geliştirme aşamasında SQLite, üretim / ileriki aşamada PostgreSQL için yapılandırılabilir.
// SQLite enum desteklemediği için type ve systemDirection alanları String olarak tanımlanmıştır.
// PostgreSQL'e geçiş için:
// 1. provider = "postgresql" olarak güncelleyin.
// 2. .env içindeki DATABASE_URL'i PostgreSQL bağlantı adresine çekin.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id              String                    @id @default(cuid())
  name            String
  description     String?
  plants          PowerPlant[]
  pricingProfiles ImbalancePricingProfile[]
  importTemplate  String?                   // Son onaylanan kolon eşleştirmesi (JSON: santral id → PlantImportMapping)
  /// Doluysa proje bir toplayıcı portföyüdür: tüm santraller bu adla tek dengede uzlaştırılır (sahip şirketler santralde kalır)
  aggregatorName  String?
  /// Toplayıcının EPİAŞ portföy özeti (JSON: orgId, orgName, asOf, plantCount, byType, plantIds); kapsam cümlesi için
  aggregatorPortfolio String?
  /// Projenin veri dönemi ("YYYY-MM-DD", gün dahil). Havuzdan okunan santrallerin saatleri bu aralıktan alınır (PLAN 7.7);
  /// boşsa dönem kayıtlardan çıkarılır (eski ve dosyadan yüklenen projeler)
  periodStart     String?
  periodEnd       String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
}

model PowerPlant {
  id          String             @id @default(cuid())
  name        String
  type        String             // "RES" | "HES" | "GES"
  capacityMw  Float
  /// EPİAŞ santral kimliği (UEVM santral listesi); EPİAŞ'tan eklenen santrallerde dolu
  epiasPlantId     Int?
  /// EPİAŞ'tan eklenen santralin veri kaynağı: KGÜP versiyonu ("FIRST" | "FINAL") ve uzlaştırma birimleri (virgülle)
  kgupVersion      String?
  uevcbIds         String?
  /// Santralin sahibi olan piyasa katılımcısı. Dengesizlik şirket bazında uzlaştırılır: aynı şirketin santralleri zaten netleşir
  organizationId   Int?
  organizationName String?
  /// Verinin dönemi içinde YEKDEM'den yararlanıyor mu (EPİAŞ YEKDEM santral listesine göre)
  yekdem           Boolean?
  /// Verinin son yılından sonraki yıl YEKDEM'de mi: yekdem=true ve bu alan false ise santral YEKDEM'den çıkıyor
  /// (piyasa fiyatına ve dengesizliğe doğrudan maruz kalıyor); null ise sonraki yılın listesi alınamadı
  yekdemNextYear   Boolean?
  /// Saatlik veri veri havuzundan okunur (data/pool; PLAN 7.7): GenerationRecord yazılmaz. false: kayıtlar veritabanında
  /// (dosyadan yüklenen santraller ve 7.7 öncesi projeler)
  poolBacked       Boolean  @default(false)
  projectId   String?
  project     Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  records     GenerationRecord[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model MarketData {
  id              String             @id @default(cuid())
  timestamp       DateTime           @unique
  ptf             Float              // Piyasa Takas Fiyatı (TL/MWh)
  smf             Float              // Sistem Marjinal Fiyatı (TL/MWh)
  systemDirection String             // "SURPLUS" | "DEFICIT" | "BALANCED"
  gipPrice        Float?             // Gün İçi Piyasası Ağırlıklı Ortalama Fiyatı (TL/MWh, opsiyonel)
  gipVolumeMwh    Float?             // GİP saatlik kontratında eşleşen toplam miktar (MWh)
  gipMinPrice     Float?             // GİP saatlik kontratının en düşük eşleşme fiyatı (TL/MWh)
  gipMaxPrice     Float?             // GİP saatlik kontratının en yüksek eşleşme fiyatı (TL/MWh)
  imbalancePosPrice Float?           // EPİAŞ resmi pozitif dengesizlik fiyatı (TL/MWh): sistem pozitif dengesizlik tutarı / miktarı
  imbalanceNegPrice Float?           // EPİAŞ resmi negatif dengesizlik fiyatı (TL/MWh): sistem negatif dengesizlik tutarı / miktarı
  source          String             @default("LEGACY") // "EPIAS" | "FILE" | "SEED" | "LEGACY" (kaynağı doğrulanmamış eski kayıt)
  syncedAt        DateTime?          // EPİAŞ'tan çekildiği veya dosyadan yüklendiği son an (eski kayıtlarda boş)
  records         GenerationRecord[]
  createdAt       DateTime           @default(now())
}

model GenerationRecord {
  id                String       @id @default(cuid())
  plantId           String
  plant             PowerPlant   @relation(fields: [plantId], references: [id], onDelete: Cascade)
  marketDataId      String?
  marketData        MarketData?  @relation(fields: [marketDataId], references: [id])
  timestamp         DateTime
  forecastMwh       Float        // Gün Öncesi Üretim Tahmini (KGÖP)
  actualMwh         Float        // Gerçekleşen Üretim
  imbalanceMwh      Float        // Dengesizlik Miktarı (actual - forecast)
  imbalanceCostTl   Float        // Dengesizlik Maliyeti
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([plantId, timestamp])
}

model ImbalancePricingProfile {
  id                  String   @id @default(cuid())
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                String   @default("EPİAŞ Standart Profil")
  /// REGULATORY: katsayılar saatin tarihine göre mevzuattan seçilir; CUSTOM: aşağıdaki katsayılar her tarihe uygulanır
  mode                String   @default("REGULATORY")
  positiveSurplusCoef Float    @default(0.94)
  positiveOtherCoef   Float    @default(0.97)
  negativeDeficitCoef Float    @default(1.06)
  negativeOtherCoef   Float    @default(1.03)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([projectId])
}
